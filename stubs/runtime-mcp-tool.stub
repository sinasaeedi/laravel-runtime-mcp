    // you use there); HTTP, SOAP, Redis and files are not.
    public function opensWorld(): bool
    {
        return {{ openWorld }};
    }

    // Types, max lengths, enums, max limits. Keep it in step with rules().
    public function schema(JsonSchema $schema): array
    {
        return [];
    }

    // The same limits, enforced. An argument that no rule names is refused.
