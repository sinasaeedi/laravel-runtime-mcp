    {
        return [];
    }

    // Bound your own work: a timeout on every external call, a maximum count on every list.
    // Return ToolResult::unavailable('why') when you could not look, never an empty result.
    public function execute(ToolInput $input): ToolResult
    {
        return ToolResult::unavailable('Not implemented yet.');
    }
